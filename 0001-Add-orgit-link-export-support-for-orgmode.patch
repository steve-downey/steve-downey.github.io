From a8bcf4c840707b2fc3169000b95ac4c4bb4bcf32 Mon Sep 17 00:00:00 2001
From: Steve Downey <sdowney2@bloomberg.net>
Date: Sun, 31 May 2026 12:44:03 -0400
Subject: [PATCH] Add orgit link export support for orgmode

---
 plugins/orgmode/init.el | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/plugins/orgmode/init.el b/plugins/orgmode/init.el
index fc3207d..db76002 100644
--- a/plugins/orgmode/init.el
+++ b/plugins/orgmode/init.el
@@ -125,6 +125,39 @@
                 (format "<a href=\"link:%s\">%s</a>"
                         path (or desc path))))))
 
+;; Export orgit links as source browser URLs
+
+(defvar orgit-base-url "https://github.com/steve-downey/schemepoc/blob/main/"
+
+  "Base URL for exporting orgit links.")
+
+
+
+(org-link-set-parameters
+
+ "orgit"
+
+ :export (lambda (path desc backend)
+
+           (let* ((parts (split-string path "::"))
+
+                  (filepath (if (> (length parts) 1) (cadr parts) path))
+
+                  (url (concat orgit-base-url filepath)))
+
+             (cond
+
+              ((or (eq 'md backend) (eq 'gfm backend))
+
+               (format "[`%s`](%s)" (or desc filepath) url))
+
+              ((eq 'html backend)
+
+               (format "<a href=\"%s\"><code>%s</code></a>" url (or desc filepath)))
+
+              (t url)))))
+
+
 ;; Export function used by Nikola.
 (defun nikola-html-export (infile outfile)
   "Export the body only of the input file and write it to
